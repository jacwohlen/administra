{
  "name": "administra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "perf:bundle": "node scripts/perf/bundle-report.mjs",
    "perf:measure": "node scripts/perf/measure.mjs",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@carbon/charts-svelte": "^1.22.18",
    "@eslint/js": "^10.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@playwright/test": "^1.64.1",
    "@skeletonlabs/skeleton": "^4.15.2",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@supabase/supabase-js": "^2.119.0",
    "@sveltejs/adapter-netlify": "^7.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "d3": "^7.9.2",
    "dayjs": "^1.11.23",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "image-resize-compress": "^4.1.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "supabase": "^3.1.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-fa": "^4.0.4",
    "svelte-i18n": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@sentry/sveltekit": "^11.10.0",
    "@supabase/ssr": "^0.12.7",
    "nodemailer": "^10.3.1"
  }
}
