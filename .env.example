# --- Infrastructure (required) -------------------------------------------
# Read via $env/static/public: a missing value is a build error.

PUBLIC_SUPABASE_DATABASE_URL="http://127.0.0.1:54321"
# The project's publishable key (sb_publishable_...); the variable keeps its old name
PUBLIC_SUPABASE_ANON_KEY=""

PUBLIC_SUPABASE_SITE_URL="http://localhost:5173"
PRIVATE_SUPABASE_AUTH_GOOGLE_CLIENT_ID=""
PRIVATE_SUPABASE_AUTH_GOOGLE_SECRET=""
PRIVATE_SUPABASE_AUTH_GOOGLE_CALLBACK_URI="http://127.0.0.1:54321/auth/v1/callback"

PUBLIC_MODE=DEV # PROD, DEV, DEMO
# DEMO is only for the public demo (demo.alleda.ch, its own Supabase project): one-click role logins, see docs/DEMO.md.

# --- E-mails to trial candidates (optional) -------------------------------
# The club's SMTP server, used for the thank-you mail after the public
# registration and the mails staff send from /dashboard/probetraining. Read
# at runtime; leave PRIVATE_SMTP_HOST empty and mails are only logged as
# "not sent" (keep it that way for Deploy Previews). Port 587 uses STARTTLS,
# 465 implicit TLS. See docs/TRIAL_EMAILS.md.

#PRIVATE_SMTP_HOST="smtp.example.ch"
#PRIVATE_SMTP_PORT=587
#PRIVATE_SMTP_USER=""
#PRIVATE_SMTP_PASSWORD=""
#PRIVATE_SMTP_FROM="JAC Wohlen <probetraining@jacwohlen.ch>"

# --- Daten-Assistent (optional) ------------------------------------------
# Reads Judo passes, attendance lists, training plans, lesson plans and
# dates from photos, PDFs or pasted text with Claude (Anthropic). Without a
# key the assistant is not offered. Read at runtime; mark the key as secret
# in Netlify and keep it out of Deploy Previews. See docs/AI_ASSISTANT.md.

#PRIVATE_ANTHROPIC_API_KEY=""
#PRIVATE_ASSISTANT_MODEL="claude-opus-5-5"
#PRIVATE_ASSISTANT_EFFORT="low"
#PRIVATE_ASSISTANT_TIMEOUT_MS=50000

# --- Error monitoring (optional) ------------------------------------------
# Sentry, EU region. Without a DSN no errors are reported (local development,
# CI). The DSN is not secret (it is visible in the browser). Read at runtime.
# See docs/ERROR_MONITORING.md.

#PUBLIC_SENTRY_DSN="https://...@o0.ingest.de.sentry.io/0"

# Netlify builds only: upload source maps for readable stack traces. The
# token is secret (Sentry → Settings → Organization Tokens).
#SENTRY_AUTH_TOKEN=""
#SENTRY_ORG=""
#SENTRY_PROJECT=""

# --- Club settings (optional) --------------------------------------------
# Which club this deployment serves. Every value has a default (see
# src/lib/clubConfig.ts); leave a line out or empty to keep it. Read via
# $env/dynamic/public, so a missing value never breaks the build. Set them
# per deploy context in Netlify to differ between dev and prod.
#
# Admins can also override each of these at runtime from the settings page
# (/dashboard/settings, stored in the app_settings table). A stored setting
# wins over the environment value; clearing it there falls back here.

# Display name on public-facing pages.
#PUBLIC_CLUB_NAME="JAC Wohlen"

# The club's public website, linked from public-facing pages.
#PUBLIC_CLUB_URL="https://jacwohlen.ch"

# Club logo: an absolute URL or a path under static/. Defaults to the logo
# hosted on the club website; if it ever fails to load the app falls back to
# its own mark. To self-host instead, drop a file into static/ and point here.
#PUBLIC_CLUB_LOGO="https://jacwohlen.ch/wp-content/uploads/2019/01/jacw_logo_favicon-1-300x300.png"

# Public address for enquiries. Unset = not shown anywhere.
#PUBLIC_CLUB_CONTACT_EMAIL=""

# Comma-separated. Offered wherever a training, event or trial candidate
# is assigned a section. Blank falls back to the default, never to none.
#PUBLIC_CLUB_SECTIONS="Judo,Aikido"

# Trial sessions after which a candidate is flagged to become a member.
# Whole number, at least 1.
#PUBLIC_TRIAL_SESSION_THRESHOLD=3

# Days without attendance after which an assigned trial candidate is
# flagged as inactive (and can be archived). Whole number, at least 1.
#PUBLIC_TRIAL_INACTIVE_DAYS=60

# Language of public-facing pages unless the visitor switches: de or en.
#PUBLIC_DEFAULT_LOCALE=de
